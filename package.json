{
  "name": "todo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-public-smoke --project=chromium-authenticated-smoke",
    "test:e2e:install": "playwright install chromium",
    "preview:e2e": "vite preview --host localhost --port 8081 --strictPort",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue && npm run typecheck:e2e",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@fullcalendar/vue3": "^6.1.15",
    "dhtmlx-gantt": "^10.0.2",
    "pinia": "^2.3.1",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
